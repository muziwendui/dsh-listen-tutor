{
  "name": "dsh-listen-tutor",
  "version": "0.3.2",
  "description": "听课助手：在 B 站视频页面上浮一块讲解面板，按页切分讲解稿、跟着播放逐句推进，没听懂可以直接提问。读 Safari 里那一集的播放进度和 PPT 画面。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "study",
    "bilibili",
    "tutor"
  ],
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "author": "muziwendui",
  "repository": {
    "type": "git",
    "url": "https://github.com/muziwendui/dsh-listen-tutor.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check lib/host.js && node --check lib/client.js && node --check lib/panel-inject.js && node --check lib/slide-watch.js"
  }
}
